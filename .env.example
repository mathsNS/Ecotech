# development ou production
ECOTECH_ENV=development

# Em production, use dois segredos distintos com no minimo 32 caracteres.
ECOTECH_SECRET_KEY=troque-por-um-segredo-de-sessao-longo
ECOTECH_JWT_SECRET=troque-por-um-segredo-jwt-longo-e-distinto
ECOTECH_JWT_EXPIRACAO_HORAS=8

# Separe origens autorizadas por virgula. Use * apenas em desenvolvimento.
ECOTECH_CORS_ORIGINS=http://localhost:5000
